{
  "name": "lolly-work",
  "private": true,
  "version": "0.2.0",
  "description": "Lolly control plane — identity, provisioning, governance, serving, telemetry. MPL-2.0.",
  "type": "module",
  "license": "MPL-2.0",
  "bin": {
    "lw": "cli/lw.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prestart": "node scripts/console-assets.ts --check",
    "start": "node server/src/main.ts",
    "migrate": "node scripts/migrate.ts",
    "migrate:status": "node scripts/migrate.ts --check",
    "predemo": "node scripts/console-assets.ts --check",
    "demo": "node scripts/demo.ts",
    "cli": "node cli/lw.ts",
    "verify:engine-pin": "node scripts/verify-engine-pin.ts",
    "update:shell:build": "node scripts/prepare-shell-update.ts",
    "update:shell": "python3 -B scripts/update-private-shell.py",
    "update:public-shell:build": "node scripts/prepare-public-shell-update.ts",
    "update:public-shell:prepare": "python3 -B scripts/prepare-public-shell.py",
    "update:shell:prepare": "python3 -B scripts/prepare-private-shell.py",
    "update:shell:stage": "python3 -B scripts/stage-private-shell.py",
    "update:shell:plan": "python3 -B scripts/plan-private-shell.py",
    "update:shell:publish": "python3 -B scripts/publish-private-shell.py",
    "repin-engine": "node scripts/repin-engine.ts",
    "readiness": "node scripts/production-readiness.ts",
    "inspect:pack": "node scripts/inspect-pack.ts",
    "check:setup": "node scripts/check-setup.ts",
    "sbom": "node scripts/build-sbom.ts",
    "release:yunohost": "node scripts/yunohost-release.ts",
    "console:build": "node scripts/console-assets.ts",
    "console:check": "node scripts/console-assets.ts --check",
    "pretest": "node scripts/verify-engine-pin.ts && node scripts/console-assets.ts --check",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check:docs-vernacular": "node scripts/check-docs-vernacular.ts",
    "check:code-comments": "node scripts/check-code-comment-vernacular.ts",
    "update:npm-licenses": "node scripts/update-npm-licenses.ts pnpm-lock.yaml workers/render/pnpm-lock.yaml",
    "setup:apply": "node scripts/apply-setup.ts",
    "build:vercel": "node scripts/build-vercel-fn.mjs",
    "check:vercel": "node --no-experimental-require-module scripts/check-vercel-fn.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@lolly-tools/core": "workspace:*",
    "@lolly/engine": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@simplewebauthn/server": "14.0.3",
    "jsdom": "^30.1.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "yjs": "^13.6.33"
  },
  "packageManager": "pnpm@11.26.0"
}
