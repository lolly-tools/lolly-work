{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lolly.tools/schemas/emoji-style-v1.schema.json",
  "title": "emoji-style-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "primary",
    "fallbacks",
    "metricsPolicy",
    "treatment"
  ],
  "$defs": {
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pin",
        "checksum"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)+$"
        },
        "pin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
            }
          }
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "paletteEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hex"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "hex": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        }
      }
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/paletteEntry"
      }
    },
    "protect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skinTones",
        "flags",
        "custom"
      ],
      "properties": {
        "skinTones": {
          "type": "boolean"
        },
        "flags": {
          "type": "boolean"
        },
        "custom": {
          "type": "boolean"
        }
      }
    },
    "recipe": {
      "const": "emoji-treatment-v1"
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "primary": {
      "$ref": "#/$defs/pin"
    },
    "fallbacks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/pin"
      }
    },
    "metricsPolicy": {
      "const": "inline-em-v1"
    },
    "treatment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "strengthBps"
          ],
          "properties": {
            "mode": {
              "const": "original"
            },
            "strengthBps": {
              "const": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "strengthBps",
            "palette",
            "recipe"
          ],
          "properties": {
            "mode": {
              "const": "influence"
            },
            "strengthBps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            },
            "palette": {
              "$ref": "#/$defs/palette"
            },
            "protect": {
              "$ref": "#/$defs/protect"
            },
            "recipe": {
              "$ref": "#/$defs/recipe"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "strengthBps",
            "palette",
            "recipe"
          ],
          "properties": {
            "mode": {
              "const": "snap"
            },
            "strengthBps": {
              "const": 10000
            },
            "palette": {
              "$ref": "#/$defs/palette"
            },
            "protect": {
              "$ref": "#/$defs/protect"
            },
            "recipe": {
              "$ref": "#/$defs/recipe"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "strengthBps",
            "palette",
            "recipe"
          ],
          "properties": {
            "mode": {
              "const": "mono"
            },
            "strengthBps": {
              "const": 10000
            },
            "palette": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/paletteEntry"
              }
            },
            "protect": {
              "$ref": "#/$defs/protect"
            },
            "recipe": {
              "$ref": "#/$defs/recipe"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "strengthBps",
            "palette",
            "recipe"
          ],
          "properties": {
            "mode": {
              "const": "duotone"
            },
            "strengthBps": {
              "const": 10000
            },
            "palette": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/paletteEntry"
              }
            },
            "protect": {
              "$ref": "#/$defs/protect"
            },
            "recipe": {
              "$ref": "#/$defs/recipe"
            }
          }
        }
      ]
    }
  }
}
