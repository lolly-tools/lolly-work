{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lolly.tools/schemas/learning-module-v2.schema.json",
  "title": "Learning module v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "title",
    "description",
    "language",
    "objectives",
    "projectId",
    "sections",
    "lessons",
    "completion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "maxLength": 100000
    },
    "language": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]+$",
      "maxLength": 50
    },
    "objectives": {
      "type": "string",
      "maxLength": 100000
    },
    "projectId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "sections": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
          },
          "title": {
            "type": "string",
            "maxLength": 500
          }
        },
        "additionalProperties": false
      }
    },
    "lessons": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "required",
          "blocks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
          },
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "required": {
            "type": "boolean"
          },
          "sectionId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
          },
          "blocks": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "required": [
                "id",
                "kind"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
                },
                "kind": {
                  "enum": [
                    "text",
                    "image",
                    "video",
                    "audio",
                    "resource",
                    "slides",
                    "quiz"
                  ]
                },
                "text": {
                  "type": "string",
                  "maxLength": 100000
                },
                "description": {
                  "type": "string",
                  "maxLength": 100000
                },
                "decorative": {
                  "type": "boolean"
                },
                "transcript": {
                  "type": "string",
                  "maxLength": 100000
                },
                "captions": {
                  "type": "string",
                  "maxLength": 100000
                },
                "source": {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "asset",
                        "session"
                      ]
                    },
                    "asset": {
                      "type": "object",
                      "required": [
                        "source",
                        "id",
                        "type",
                        "format",
                        "url"
                      ],
                      "properties": {
                        "source": {
                          "enum": [
                            "library",
                            "user",
                            "remote"
                          ]
                        },
                        "id": {
                          "type": "string",
                          "maxLength": 2000
                        },
                        "type": {
                          "enum": [
                            "vector",
                            "raster",
                            "video",
                            "audio",
                            "lottie",
                            "model",
                            "lut",
                            "palette",
                            "tokens",
                            "font",
                            "profile",
                            "ratecard",
                            "text",
                            "data"
                          ]
                        },
                        "format": {
                          "type": "string",
                          "maxLength": 40
                        },
                        "url": {
                          "type": "string"
                        },
                        "version": {
                          "type": "string"
                        },
                        "pin": {
                          "type": "object",
                          "required": [
                            "version"
                          ],
                          "properties": {
                            "version": {
                              "type": "string",
                              "minLength": 1
                            },
                            "format": {
                              "type": "string"
                            }
                          },
                          "additionalProperties": false
                        },
                        "checksum": {
                          "type": "string"
                        },
                        "width": {
                          "type": "number"
                        },
                        "height": {
                          "type": "number"
                        },
                        "meta": {
                          "type": "object"
                        }
                      },
                      "additionalProperties": true
                    },
                    "slot": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "toolId": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
                    },
                    "toolVersion": {
                      "type": "string"
                    },
                    "values": {
                      "type": "object"
                    },
                    "capturedAt": {
                      "type": "string"
                    },
                    "pageIds": {
                      "type": "array",
                      "maxItems": 200,
                      "items": {
                        "type": "string",
                        "maxLength": 200
                      }
                    },
                    "motion": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "asset"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "asset"
                        ]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "session"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "toolId",
                          "values"
                        ]
                      }
                    }
                  ]
                },
                "richText": {
                  "$ref": "#/$defs/richText"
                },
                "quiz": {
                  "$ref": "#/$defs/quiz"
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "required": [
                      "richText"
                    ]
                  },
                  "then": {
                    "properties": {
                      "kind": {
                        "const": "text"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "quiz"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "quiz"
                    ],
                    "properties": {
                      "source": false
                    }
                  },
                  "else": {
                    "properties": {
                      "quiz": false
                    }
                  }
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "completion": {
      "const": "acknowledge-required"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "inline": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "marks": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "enum": [
                          "bold",
                          "italic",
                          "underline",
                          "code"
                        ]
                      },
                      "attrs": {
                        "type": "object",
                        "properties": {},
                        "required": [],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "link"
                      },
                      "attrs": {
                        "type": "object",
                        "properties": {
                          "href": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "^(https?://[^\\s/]+|mailto:[^\\s@]+@[^\\s@]+)[^\\s]*$"
                              },
                              {
                                "not": {
                                  "pattern": "[\\u0000-\\u0020\\u007f]"
                                }
                              }
                            ]
                          },
                          "target": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "rel": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "class": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "href"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "type",
                      "attrs"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "hardBreak"
            },
            "marks": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "enum": [
                          "bold",
                          "italic",
                          "underline",
                          "code"
                        ]
                      },
                      "attrs": {
                        "type": "object",
                        "properties": {},
                        "required": [],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "link"
                      },
                      "attrs": {
                        "type": "object",
                        "properties": {
                          "href": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "^(https?://[^\\s/]+|mailto:[^\\s@]+@[^\\s@]+)[^\\s]*$"
                              },
                              {
                                "not": {
                                  "pattern": "[\\u0000-\\u0020\\u007f]"
                                }
                              }
                            ]
                          },
                          "target": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "rel": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "class": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "href"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "type",
                      "attrs"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "paragraph": {
      "type": "object",
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "content": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/inline"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "listItem": {
      "type": "object",
      "properties": {
        "type": {
          "const": "listItem"
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "prefixItems": [
            {
              "$ref": "#/$defs/paragraph"
            }
          ],
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "paragraph"
            },
            "content": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "heading"
            },
            "attrs": {
              "type": "object",
              "properties": {
                "level": {
                  "enum": [
                    2,
                    3
                  ]
                }
              },
              "required": [
                "level"
              ],
              "additionalProperties": false
            },
            "content": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "required": [
            "type",
            "attrs"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "bulletList"
            },
            "content": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "items": {
                "$ref": "#/$defs/listItem"
              }
            }
          },
          "required": [
            "type",
            "content"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "orderedList"
            },
            "attrs": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              },
              "required": [
                "start"
              ],
              "additionalProperties": false
            },
            "content": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "items": {
                "$ref": "#/$defs/listItem"
              }
            }
          },
          "required": [
            "type",
            "content"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "blockquote"
            },
            "content": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "$ref": "#/$defs/block"
              },
              "minItems": 1
            }
          },
          "required": [
            "type",
            "content"
          ],
          "additionalProperties": false
        }
      ]
    },
    "richText": {
      "type": "object",
      "properties": {
        "type": {
          "const": "doc"
        },
        "content": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "quiz": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "single",
            "multiple",
            "true-false"
          ]
        },
        "prompt": {
          "type": "string",
          "maxLength": 10000
        },
        "feedback": {
          "type": "string",
          "maxLength": 10000
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
              },
              "text": {
                "type": "string",
                "maxLength": 2000
              },
              "correct": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "text",
              "correct"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "mode",
        "prompt",
        "feedback",
        "options"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "true-false"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "maxItems": 2
              }
            }
          }
        }
      ]
    }
  },
  "description": "Semantic rich text and practice quizzes. The engine parser additionally enforces unique identifiers, tree depth, aggregate node/text/document limits and valid section references. Preflight checks authored content and answer keys."
}
