{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lolly.tools/schemas/learning-module-v1.schema.json",
  "title": "Learning module v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "title",
    "description",
    "language",
    "objectives",
    "projectId",
    "sections",
    "lessons",
    "completion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "maxLength": 100000
    },
    "language": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]+$",
      "maxLength": 50
    },
    "objectives": {
      "type": "string",
      "maxLength": 100000
    },
    "projectId": {
      "type": ["string", "null"],
      "maxLength": 200
    },
    "sections": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
          },
          "title": {
            "type": "string",
            "maxLength": 500
          }
        },
        "additionalProperties": false
      }
    },
    "lessons": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "title", "required", "blocks"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
          },
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "required": {
            "type": "boolean"
          },
          "sectionId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
          },
          "blocks": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "required": ["id", "kind"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
                },
                "kind": {
                  "enum": ["text", "image", "video", "audio", "resource", "slides"]
                },
                "text": {
                  "type": "string",
                  "maxLength": 100000
                },
                "description": {
                  "type": "string",
                  "maxLength": 100000
                },
                "decorative": {
                  "type": "boolean"
                },
                "transcript": {
                  "type": "string",
                  "maxLength": 100000
                },
                "captions": {
                  "type": "string",
                  "maxLength": 100000
                },
                "source": {
                  "type": "object",
                  "required": ["kind"],
                  "properties": {
                    "kind": {
                      "enum": ["asset", "session"]
                    },
                    "asset": {
                      "type": "object",
                      "required": ["source", "id", "type", "format", "url"],
                      "properties": {
                        "source": {
                          "enum": ["library", "user", "remote"]
                        },
                        "id": {
                          "type": "string",
                          "maxLength": 2000
                        },
                        "type": {
                          "enum": [
                            "vector",
                            "raster",
                            "video",
                            "audio",
                            "lottie",
                            "model",
                            "lut",
                            "palette",
                            "tokens",
                            "font",
                            "profile",
                            "ratecard",
                            "text",
                            "data"
                          ]
                        },
                        "format": {
                          "type": "string",
                          "maxLength": 40
                        },
                        "url": {
                          "type": "string"
                        },
                        "version": {
                          "type": "string"
                        },
                        "pin": {
                          "type": "object",
                          "required": ["version"],
                          "properties": {
                            "version": {
                              "type": "string",
                              "minLength": 1
                            },
                            "format": {
                              "type": "string"
                            }
                          },
                          "additionalProperties": false
                        },
                        "checksum": {
                          "type": "string"
                        },
                        "width": {
                          "type": "number"
                        },
                        "height": {
                          "type": "number"
                        },
                        "meta": {
                          "type": "object"
                        }
                      },
                      "additionalProperties": true
                    },
                    "slot": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "toolId": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
                    },
                    "toolVersion": {
                      "type": "string"
                    },
                    "values": {
                      "type": "object"
                    },
                    "capturedAt": {
                      "type": "string"
                    },
                    "pageIds": {
                      "type": "array",
                      "maxItems": 200,
                      "items": {
                        "type": "string",
                        "maxLength": 200
                      }
                    },
                    "motion": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "asset"
                          }
                        }
                      },
                      "then": {
                        "required": ["asset"]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "session"
                          }
                        }
                      },
                      "then": {
                        "required": ["toolId", "values"]
                      }
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "completion": {
      "const": "acknowledge-required"
    }
  },
  "additionalProperties": false
}
