# The `vendor/lolly` git submodule is the SOURCE for re-pinning the engine
# (npm run repin-engine -- --apply packs it into vendor/@lolly/*). Deploys consume
# the committed, self-contained vendor/@lolly/* artifact — never the submodule — so
# keep the (large) submodule out of the upload. It stays un-inited on Vercel's
# non-recursive git checkout anyway; this covers `vercel` CLI deploys from a local
# tree where it IS inited.
vendor/lolly

# The development view links to another checkout. Hosted builds use a real
# instance pack through LW_PACK_DIR instead.
/packs/oss-view

# Workstation dependencies, settings and planning records are not build inputs.
/node_modules
**/node_modules
/plans
/.worktrees
/scratch
/.scratch
/artifacts
*.log
/.env
/.env.*
