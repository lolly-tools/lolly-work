{
  "instance": {
    "name": "SUSE Content Automation",
    "baseUrl": "http://localhost:8787",
    "pack": "./packs/demo"
  },
  "idp": {
    "issuer": "",
    "clientId": "",
    "displayName": "",
    "groupsClaim": "groups",
    "claimMap": {
      "firstname": "given_name",
      "lastname": "family_name",
      "email": "email",
      "title": "title"
    }
  },
  "policy": {
    "defaultAccessMode": "gated",
    "telemetry": "standard",
    "telemetryAttribution": "opt-in",
    "guestLinks": { "enabled": true, "maxTtlHours": 168, "defaultTtlHours": 72 },
    "nearby": { "enabled": true },
    "sessionTtlHours": 12
  },
  "render": { "allowHooksInFastPath": true },
  "rateLimit": { "enabled": true, "trustedProxyHops": 0 },
  "dev": {
    "enabled": true,
    "users": [
      { "email": "owner@example.test", "name": "Dev Owner", "groups": ["owner"] },
      { "email": "dev@example.test", "name": "Dev Admin", "groups": ["admin"] }
    ]
  },
  "catalogProviders": [
    {
      "id": "example-brandfolder",
      "kind": "brandfolder",
      "label": "Example Brandfolder",
      "credentialRef": "LW_PROVIDER_EXAMPLE_BRANDFOLDER_TOKEN",
      "enabled": false,
      "options": { "brandfolderId": "replace-with-brandfolder-id" },
      "mapping": { "defaultType": "image", "sectionTags": true },
      "exposure": { "groups": "*", "requireApproved": true, "tier": "reference" },
      "sync": { "ttlSeconds": 300 }
    }
  ],
  "delivery": {
    "maxBytes": 67108864,
    "destinations": [
      {
        "id": "example-archive",
        "kind": "s3",
        "label": "Campaign archive",
        "credentialRef": "LW_DESTINATION_EXAMPLE_ARCHIVE_CREDENTIAL",
        "enabled": false,
        "groups": "*",
        "formats": ["svg", "png", "jpg", "pdf"],
        "options": {
          "bucket": "lolly-output",
          "endpoint": "https://s3.example.test",
          "region": "us-east-1",
          "prefix": "approved"
        }
      }
    ]
  },
  "blobs": { "driver": "pg" }
}
