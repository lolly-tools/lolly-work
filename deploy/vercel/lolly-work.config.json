{
  "deployment": {
    "mode": "evaluation"
  },
  "instance": {
    "name": "Lolly Work \u2014 Demo",
    "baseUrl": "https://lolly.work",
    "pack": "packs/demo",
    "connectPack": "lolly-demo-brand-1.1.3.lolly"
  },
  "idp": {
    "issuer": "",
    "clientId": "",
    "displayName": "Demo sign-in",
    "groupsClaim": "groups",
    "claimMap": {
      "firstname": "given_name",
      "lastname": "family_name",
      "email": "email",
      "title": "title"
    }
  },
  "policy": {
    "defaultAccessMode": "open",
    "telemetry": "standard",
    "telemetryAttribution": "opt-in",
    "guestLinks": {
      "enabled": true,
      "maxTtlHours": 168,
      "defaultTtlHours": 72
    }
  },
  "render": {
    "allowHooksInFastPath": true
  },
  "dev": {
    "enabled": true,
    "users": [
      {
        "email": "admin@lolly.example",
        "name": "Ada (Admin)",
        "groups": [
          "admin"
        ]
      },
      {
        "email": "brand@lolly.example",
        "name": "Bruno (Brand lead)",
        "groups": [
          "brand-team",
          "approver"
        ]
      },
      {
        "email": "marketer@lolly.example",
        "name": "Mira (Marketer)",
        "groups": [
          "marketing"
        ]
      },
      {
        "email": "contractor@lolly.example",
        "name": "Cveta (Contractor)",
        "groups": [
          "contractors"
        ]
      }
    ]
  }
}