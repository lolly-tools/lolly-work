# Replace with the qualified custom image UUID; never use a production disk UUID.
template_uuid    = "00000000-0000-0000-0000-000000000000"
hostname         = "lolly-staging"
ssh_user         = "sles"
ssh_public_keys  = ["ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY"]
ssh_allowed_cidrs = ["192.0.2.10/32"]
zone             = "de-fra1"
plan             = "CLOUDNATIVE-2xCPU-4GB"
root_disk_gb     = 80
root_disk_tier   = "maxiops"
# Replace these with measured resolver addresses and ip_local_port_range.
dns_resolver_cidrs = ["94.237.127.9/32", "94.237.40.9/32"]
ephemeral_port_range = { start = 32768, end = 60999 }
# For reviewed K3s randomized pod SNAT, only replies from these exact DNS peers:
# dns_response_port_range = { start = 1024, end = 65535 }
ntp_server_cidrs = []
