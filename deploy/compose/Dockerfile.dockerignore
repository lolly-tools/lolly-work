# BuildKit per-Dockerfile ignore (lives beside the Dockerfile it governs).
# The context is the repo root; keep the host's node_modules out so the image
# always installs from package-lock.json, and skip everything COPY never asks for.
node_modules
.git
console/node_modules
tests
plans
workers
# docs/ is NOT ignored: the console's Docs view reads it at runtime (COPY docs).
