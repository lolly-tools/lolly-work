{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "renderWorker": {
      "type": "object",
      "properties": {
        "browserStartupTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000,
          "description": "Maximum Chromium startup or recovery time. The browser sandbox is always required."
        },
        "tls": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "serverName": {
              "type": "string"
            },
            "caSecret": {
              "type": "string"
            }
          },
          "required": [
            "existingSecret",
            "caSecret"
          ]
        },
        "seccompProfile": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "RuntimeDefault",
                "Localhost"
              ]
            },
            "localhostProfile": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+(/[a-zA-Z0-9_-]+)*\\.json$"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "appArmorProfile": {
          "type": "object",
          "description": "Empty on SELinux nodes. On AppArmor nodes, Localhost lolly-chromium (see deploy/apparmor/README.md). Requires Kubernetes 1.30+.",
          "properties": {
            "type": {
              "enum": [
                "RuntimeDefault",
                "Localhost"
              ]
            },
            "localhostProfile": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          },
          "additionalProperties": false
        },
        "userNamespace": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Run the worker with hostUsers: false and user-namespace-scoped CAP_SYS_ADMIN and CAP_SYS_CHROOT for Chromium's sandbox. Requires Kubernetes 1.33+."
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
