# Patterns to ignore when packaging the chart (helm package / helm install .).
.DS_Store
.git/
.gitignore
*.tmproj
*.bak
*.orig
*.swp
*~
.idea/
.vscode/
# Never bundle real config or secrets into the chart archive.
instance.json
*.env
.env
# Unit tests for the alert rules run from tests/helm-chart.test.ts, not from the chart.
files/*.test.yaml
