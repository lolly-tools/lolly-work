# /opt/lolly-ing/.env on the VM: the server's secrets, by name only.
# deploy/vm/secrets.sh writes the real file over ssh with mode 0600 and never
# prints a value; do not copy values into this example or into the repository.
# Values are single-quoted in the real file, so `$` and `#` stay literal.

# Neon Postgres, the DIRECT (unpooled) connection string: the host without
# "-pooler". The server runs migrations over it and holds its own small pools.
DATABASE_URL=

# The same values as the Vercel project lolly-ing, so either host can serve the
# instance: the session secret also keys the audit log's MACs, and both sign the
# sessions and share links already issued. secrets.sh asks for them; left empty
# on a first run it generates new ones on the VM, with a warning.
LW_SESSION_SECRET=
LW_LINK_SECRET=

# Google OAuth client secret (the primary identity provider, idp.clientId in instance.json).
LW_IDP_CLIENT_SECRET=

# GitHub OAuth App client secret (idp.additional "github" clientSecretRef). Optional;
# without it, remove the GitHub entry from instance.json or its sign-ins fail.
LW_IDP_GITHUB_SECRET=

# Catalog signing key: the private half of lolly/keys/catalog-signing.pub.jwk.json,
# stored as a private JWK on one line (secrets.sh converts the PEM).
LW_CATALOG_SIGNING_KEY=

# Optional Chromium tier. Set the same key on server and worker; configure
# render.worker.url=http://render-worker:8791 in instance.json to deploy it.
LW_RENDER_WORKER_SECRET=

# Optional. How often the durable render and automation runners look for queued
# work, in ms. docker-compose.yml defaults it to 0 (no timer) so Neon can suspend.
# LW_BACKGROUND_POLL_MS=0
