# Lolly Work runtime environment. Read by systemd (EnvironmentFile), so values are
# literal: no shell expansion. Written by the YunoHost package at install and kept
# across upgrades; secrets are generated once and never leave this host.
#
# NODE_ENV=production is what makes a missing secret a hard failure instead of a
# silent random key per process (which would log everyone out on every restart).
NODE_ENV=production
PORT=__PORT__
LW_CONFIG=__INSTALL_DIR__/instance.json
DATABASE_URL=postgres://__DB_USER__:__DB_PWD__@127.0.0.1:5432/__DB_NAME__
LW_SESSION_SECRET=__SESSION_SECRET__
LW_LINK_SECRET=__LINK_SECRET__
# The shared secret nginx attaches to every proxied request (conf/proxy.inc). The
# server only believes the SSOwat identity headers when it is present, so a local
# process that reaches the port directly cannot claim to be someone.
LW_PROXY_AUTH_SECRET=__PROXY_SECRET__
