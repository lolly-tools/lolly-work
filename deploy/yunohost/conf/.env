# Read by systemd (EnvironmentFile): values are literal, with no shell expansion.
# NODE_ENV=production makes a missing secret fatal, not a new random key per restart.
NODE_ENV=production
PORT=__PORT__
LW_CONFIG=__INSTALL_DIR__/instance.json
DATABASE_URL=postgres://__DB_USER__:__DB_PWD__@127.0.0.1:5432/__DB_NAME__
LW_SESSION_SECRET=__SESSION_SECRET__
LW_LINK_SECRET=__LINK_SECRET__
# Sent by nginx (proxy.inc): the server trusts SSOwat's headers only with it.
LW_PROXY_AUTH_SECRET=__PROXY_SECRET__
# Single quotes keep the JSON literal for systemd.
LW_CATALOG_SIGNING_KEY='__CATALOG_SIGNING_KEY__'
# <login>:<app password> once Nextcloud is connected in the config panel, else empty.
LW_PROVIDER_NEXTCLOUD='__NEXTCLOUD_CREDENTIAL__'
LW_DESTINATION_NEXTCLOUD='__NEXTCLOUD_CREDENTIAL__'
