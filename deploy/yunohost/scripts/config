#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

# The stock step saves the settings; instance.json is rendered from them.
ynh_app_config_apply() {
    _ynh_app_config_apply
    lollywork_add_config
}

validate__nextcloud_enabled() {
    # Only a switched-on connection must be complete.
    [[ "${nextcloud_enabled:-false}" == "true" ]] || return 0
    lollywork_nextcloud_check || true
}

get__nextcloud_detected() {
    local found
    found=$(lollywork_detect_nextcloud)
    echo "${found:-No Nextcloud app found on this server}"
}

ynh_app_config_run "$1"
