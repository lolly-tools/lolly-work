#!/bin/bash
# SPDX-License-Identifier: MPL-2.0
# Every boot, after K3s: copy this machine's systemd credentials into the three
# Kubernetes Secrets that Lolly Work, its PostgreSQL and Traefik read. systemd
# decrypts the credentials into $CREDENTIALS_DIRECTORY (a private, unswappable
# directory) only for this service; values travel to the API on stdin and from
# files, never on a command line. K3s keeps Secrets encrypted at rest
# (secrets-encryption in /etc/rancher/k3s/config.yaml).
set -euo pipefail
. /usr/libexec/lolly-appliance/common.sh
umask 077

: "${CREDENTIALS_DIRECTORY:?run through lolly-appliance-secrets.service}"
: "${RUNTIME_DIRECTORY:?run through lolly-appliance-secrets.service}"
c=$CREDENTIALS_DIRECTORY
for name in $CREDENTIALS; do
  [ -s "$c/$name" ] || { log "credential $name is missing; run the first boot again (remove /var/lib/lolly/firstboot.done)"; exit 1; }
done

wait_for_api 900
deadline=$((SECONDS + 600))
until "${KUBECTL[@]}" get namespace lolly >/dev/null 2>&1; do
  [ $SECONDS -lt $deadline ] || { log "namespace lolly did not appear"; exit 1; }
  sleep 3
done

printf 'postgres://lolly:%s@lolly-postgres.lolly.svc.cluster.local:5432/lollywork' "$(cat "$c/lolly-postgres-password")" > "$RUNTIME_DIRECTORY/database-url"

apply() { # server-side apply keeps no copy of the data in an annotation
  "${KUBECTL[@]}" apply --server-side --force-conflicts --field-manager=lolly-appliance -f - >/dev/null
}

"${KUBECTL[@]}" -n lolly create secret generic lolly-postgres --dry-run=client -o yaml \
  --from-file=POSTGRES_PASSWORD="$c/lolly-postgres-password" | apply
"${KUBECTL[@]}" -n lolly create secret generic lolly-work-secrets --dry-run=client -o yaml \
  --from-file=DATABASE_URL="$RUNTIME_DIRECTORY/database-url" \
  --from-file=LW_SESSION_SECRET="$c/lolly-session-secret" \
  --from-file=LW_LINK_SECRET="$c/lolly-link-secret" \
  --from-file=LW_CREDENTIAL_SECRET="$c/lolly-credential-secret" \
  --from-file=LW_CATALOG_SIGNING_KEY="$c/lolly-catalog-signing-key" | apply
"${KUBECTL[@]}" -n kube-system create secret tls lolly-appliance-tls --dry-run=client -o yaml \
  --cert="$TLS_DIR/appliance.crt" --key="$c/lolly-tls-key" | apply
rm -f "$RUNTIME_DIRECTORY/database-url"
log "secrets are in place"
