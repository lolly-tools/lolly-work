# Copies this machine's systemd credentials into the Kubernetes Secrets that
# Lolly Work, PostgreSQL and Traefik read. systemd decrypts each credential
# (TPM2-bound where the machine has a TPM) only for this service.
[Unit]
Description=Lolly appliance: hand this machine's secrets to K3s
After=k3s.service lolly-appliance-firstboot.service
Requires=k3s.service

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=lolly-appliance-secrets
RuntimeDirectoryMode=0700
LoadCredentialEncrypted=lolly-session-secret:/var/lib/lolly/credentials/lolly-session-secret.cred
LoadCredentialEncrypted=lolly-link-secret:/var/lib/lolly/credentials/lolly-link-secret.cred
LoadCredentialEncrypted=lolly-credential-secret:/var/lib/lolly/credentials/lolly-credential-secret.cred
LoadCredentialEncrypted=lolly-postgres-password:/var/lib/lolly/credentials/lolly-postgres-password.cred
LoadCredentialEncrypted=lolly-catalog-signing-key:/var/lib/lolly/credentials/lolly-catalog-signing-key.cred
LoadCredentialEncrypted=lolly-tls-key:/var/lib/lolly/credentials/lolly-tls-key.cred
ExecStart=/usr/libexec/lolly-appliance/secrets
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
