# Lolly Work @WORK_VERSION@ for the appliance's k3s profile. GENERATED by
# deploy/appliance/generate.py from deploy/marketplaces/release.json and
# deploy/helm (chart @CHART_VERSION@); do not edit on a machine. K3s's built-in
# Helm controller installs it from /var/lib/rancher/k3s/server/manifests.
# This machine's own values (address, owner) are in lolly-work-instance.yaml,
# a HelmChartConfig that the first boot writes.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: lolly-work
  namespace: kube-system
  labels:
    app.kubernetes.io/part-of: lolly-appliance
  annotations:
    lolly.work/release: "@WORK_VERSION@"
    lolly.work/chart-sha256: "@CHART_SHA256@"
spec:
  targetNamespace: lolly
  createNamespace: false
  timeout: 600s
  chartContent: @CHART_CONTENT@
  valuesContent: |-
@VALUES_CONTENT@
