# HTTPS for Lolly Work @WORK_VERSION@ on the appliance's podman profile: Caddy
# with the machine's own self-signed certificate on 443, and 80 redirecting.
# GENERATED by deploy/appliance/generate.py from deploy/marketplaces/release.json
# (caddyImage @CADDY_IMAGE_REF@); lolly-update changes the Image line.
# Kept in /var/lib/lolly/quadlet, outside the root snapshots, and linked from
# /etc/containers/systemd.
#
# Caddy runs as nobody on unprivileged ports (8443 and 8080, published as 443
# and 80), with no admin endpoint and no automatic certificates. The image's
# caddy binary carries the file capability cap_net_bind_service, and the
# kernel refuses to run such a binary when that capability is not available,
# so it is the one capability kept. The certificate's key is this machine's
# systemd credential, handed over on a tmpfs (container-files).
[Unit]
Description=Lolly appliance: HTTPS for Lolly Work (Caddy)
Wants=lolly-appliance-images.service
After=lolly-appliance-images.service lolly-appliance-firstboot.service

[Container]
ContainerName=lolly-caddy
Image=@CADDY_IMAGE@
Pull=never
Network=lolly.network
PublishPort=443:8443
PublishPort=80:8080
User=65534:65534
ReadOnly=true
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true
SecurityLabelLevel=s0:c30,c31
Volume=/run/lolly/containers/caddy:/run/lolly:ro
Tmpfs=/data:rw,size=16m,mode=1777
Tmpfs=/config:rw,size=16m,mode=1777
Exec=caddy run --config /run/lolly/Caddyfile --adapter caddyfile
PodmanArgs=--memory=128m

[Service]
LoadCredentialEncrypted=lolly-tls-key:/var/lib/lolly/credentials/lolly-tls-key.cred
ExecStartPre=/usr/libexec/lolly-appliance/container-files caddy
ExecStopPost=/usr/libexec/lolly-appliance/container-files clean caddy
Restart=always

[Install]
WantedBy=multi-user.target
