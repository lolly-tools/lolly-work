# Lolly Work @WORK_VERSION@ on the appliance's podman profile.
# GENERATED by deploy/appliance/generate.py from deploy/marketplaces/release.json
# (serverImage @SERVER_IMAGE_REF@); lolly-update changes the Image line.
# Kept in /var/lib/lolly/quadlet, outside the root snapshots, and linked from
# /etc/containers/systemd.
#
# Settings: /var/lib/lolly/work/instance.json, written at boot from
# /usr/share/lolly-appliance/work-config.json (the same settings as the k3s
# profile) and this machine's address and owner. Secrets: this machine's
# systemd credentials, decrypted by systemd for this unit alone and handed to
# the container on a tmpfs (container-files). The container reads them into
# the server's environment as it starts; podman never stores them, so no copy
# lands in container storage. Work applies pending migrations as it starts
# (LW_AUTO_MIGRATE), after lolly-update has taken its backup.
[Unit]
Description=Lolly appliance: Lolly Work
Requires=lolly-postgres.service
After=lolly-postgres.service lolly-appliance-instance.service

[Container]
ContainerName=lolly-work
Image=@SERVER_IMAGE@
Pull=never
Network=lolly.network
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
SecurityLabelLevel=s0:c20,c21
Environment=NODE_ENV=production PORT=8787 LW_CONFIG=/run/lolly/instance.json LW_AUTO_MIGRATE=true
Volume=/run/lolly/containers/work:/run/lolly:ro
Tmpfs=/tmp:rw,size=256m,mode=1777
Exec=/bin/sh -ec 'for f in /run/lolly/env/*; do export "$${f##*/}=$$(cat "$$f")"; done; exec node server/src/main.ts'
HealthCmd=node -e "fetch('http://127.0.0.1:8787/readyz',{signal:AbortSignal.timeout(4000)}).then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
HealthInterval=10s
HealthStartPeriod=180s
HealthRetries=3
Notify=healthy
StopTimeout=30
PodmanArgs=--memory=512m --cpus=1

[Service]
LoadCredentialEncrypted=lolly-session-secret:/var/lib/lolly/credentials/lolly-session-secret.cred
LoadCredentialEncrypted=lolly-link-secret:/var/lib/lolly/credentials/lolly-link-secret.cred
LoadCredentialEncrypted=lolly-credential-secret:/var/lib/lolly/credentials/lolly-credential-secret.cred
LoadCredentialEncrypted=lolly-postgres-password:/var/lib/lolly/credentials/lolly-postgres-password.cred
LoadCredentialEncrypted=lolly-catalog-signing-key:/var/lib/lolly/credentials/lolly-catalog-signing-key.cred
ExecStartPre=/usr/libexec/lolly-appliance/container-files work
ExecStopPost=/usr/libexec/lolly-appliance/container-files clean work
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
