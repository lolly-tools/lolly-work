# The container network for Lolly Work on the appliance's podman profile.
# GENERATED by deploy/appliance/generate.py; kept in /var/lib/lolly/quadlet
# and linked from /etc/containers/systemd.
#
# The bridge takes the host interface's MTU, which
# lolly-appliance-network.service works out at each boot. A bridge left at
# 1500 on a smaller link (1442 on MulgaDC Spinifex) stalls large transfers.
# The network is removed when it stops, so the next boot creates it again
# with the current MTU.
[Unit]
Description=Lolly appliance: the container network for Lolly Work
Requires=lolly-appliance-network.service
After=lolly-appliance-network.service

[Network]
NetworkName=lolly
Subnet=10.89.0.0/24
Gateway=10.89.0.1
Options=mtu=${LOLLY_MTU}
NetworkDeleteOnStop=true

[Service]
EnvironmentFile=/run/lolly/network.env
