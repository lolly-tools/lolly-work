# PostgreSQL for Lolly Work @WORK_VERSION@ on the appliance's podman profile.
# GENERATED by deploy/appliance/generate.py from deploy/marketplaces/release.json
# (postgresImage @POSTGRES_IMAGE_REF@); lolly-update changes the Image line.
# Kept in /var/lib/lolly/quadlet, outside the root snapshots, and linked from
# /etc/containers/systemd.
#
# Data lives in /var/lib/lolly/postgres. The password is this machine's systemd
# credential, decrypted by systemd for this unit alone and handed to the
# container on a tmpfs (container-files), never on disk in plain text.
[Unit]
Description=Lolly appliance: PostgreSQL for Lolly Work
Wants=lolly-appliance-images.service
After=lolly-appliance-images.service lolly-appliance-firstboot.service

[Container]
ContainerName=lolly-postgres
Image=@POSTGRES_IMAGE@
Pull=never
Network=lolly.network
User=999:999
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
SecurityLabelLevel=s0:c10,c11
Environment=POSTGRES_USER=lolly POSTGRES_DB=lollywork PGDATA=/var/lib/postgresql/data/pgdata POSTGRES_PASSWORD_FILE=/run/lolly/POSTGRES_PASSWORD
Volume=/var/lib/lolly/postgres:/var/lib/postgresql/data:Z
Volume=/run/lolly/containers/postgres:/run/lolly:ro
Tmpfs=/run/postgresql:rw,size=16m,mode=1777
HealthCmd=pg_isready -h 127.0.0.1 -U lolly -d lollywork
HealthInterval=5s
HealthStartPeriod=30s
HealthRetries=3
Notify=healthy
StopTimeout=60
PodmanArgs=--memory=512m

[Service]
LoadCredentialEncrypted=lolly-postgres-password:/var/lib/lolly/credentials/lolly-postgres-password.cred
ExecStartPre=/usr/libexec/lolly-appliance/container-files postgres
ExecStopPost=/usr/libexec/lolly-appliance/container-files clean postgres
Restart=always
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
